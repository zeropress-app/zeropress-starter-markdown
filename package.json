{
  "name": "zeropress-starter-markdown",
  "version": "0.7.0",
  "description": "A static ZeroPress site written in Markdown",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "zeropress-build-pages --theme-path ./theme --source ./documents --public-dir ./public --destination ./dist --no-copy-markdown-source",
    "postbuild": "npm run search:replace-with-pagefind",
    "search:replace-with-pagefind": "node scripts/replace-search-with-pagefind.mjs",
    "preview": "npm run build && wrangler dev --local",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "test": "node --test test/*.test.mjs",
    "format:wrangler": "node scripts/format-wrangler.mjs",
    "format:wrangler:check": "node scripts/format-wrangler.mjs --check"
  },
  "dependencies": {
    "@zeropress/build-pages": "^1.0.3"
  },
  "devDependencies": {
    "jsonc-parser": "3.3.1",
    "pagefind": "1.5.2",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
